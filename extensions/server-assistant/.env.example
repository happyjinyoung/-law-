# 기본값은 키가 필요 없는 로컬 규칙 모드입니다.
# AI는 OpenAI Responses 호환 API. 사용 가능한 모델의 정확한 ID를 입력하세요.
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=https://api.openai.com/v1
AI_TIMEOUT_SECONDS=40
PORT=8765
# 선택 사항: 경로를 바꾸면 해당 DB도 .gitignore 대상인지 확인하세요.
# APP_DB=data/app.sqlite3
# Windows 예: C:/Program Files/Tesseract-OCR/tesseract.exe
TESSERACT_CMD=
